{
  "schemaVersion": 1,
  "id": "seeu_extra",
  "version": "${version}",
  "name": "SeeU Extra",
  "description": "Renders configured non-player entities beyond the vanilla tracking range through SeeU.",
  "authors": [
    "Keryesh4ka"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.keryeshka.seeu.extra.fabric.SeeUExtraFabric"
    ],
    "client": [
      "dev.keryeshka.seeu.extra.fabric.client.SeeUExtraFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "fabric-api": "*",
    "seeu": ">=0.9.0"
  },
  "contact": {
    "sources": "https://github.com/cat4blep/SeeU",
    "issues": "https://github.com/cat4blep/SeeU/issues"
  }
